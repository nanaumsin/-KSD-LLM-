# 3. JavaScript Bridge 

def capture_ksd(label=""):
    # [보안 우회 완료 버전] 브라우저 정책을 우회하여 URL 파라미터를 안전하게 전송합니다.
    js_template = """
    <div id="ksd-container">
        <p style="color: #333; font-weight: bold; font-size: 0.9rem;">{label}</p>
        <input type="text" id="ksd-input" style="width: 100%; padding: 10px; border-radius: 5px; border: 1px solid #ccc;" placeholder="여기에 입력하고 Enter를 누르세요...">
    </div>
    <script>
    let keyData = { dwell: [], flight: [], corrections: 0, total: 0 };
    let lastUp = 0;
    let keyMap = {};
    const inputField = document.getElementById('ksd-input');

    inputField.addEventListener('keydown', (e) => {
        const now = performance.now();
        if (!keyMap[e.key]) {
            keyMap[e.key] = now;
            if (lastUp > 0) keyData.flight.push(now - lastUp);
        }
        if (e.key === 'Backspace' || e.key === 'Delete') keyData.corrections++;
        keyData.total++;
    });

    inputField.addEventListener('keyup', (e) => {
        const now = performance.now();
        if (keyMap[e.key]) {
            keyData.dwell.push(now - keyMap[e.key]);
            delete keyMap[e.key];
            lastUp = now;
        }
        
        if (e.key === 'Enter') {
            e.preventDefault();
            if (!inputField.value.trim()) return;
            
            try {
                // 핵심 수정: window.top.location.href를 '읽는' 것은 보안상 차단되므로,
                // 안전하게 부모 주소를 가리키는 document.referrer를 사용합니다.
                let parentUrl = document.referrer || window.parent.location.href;
                if (!parentUrl || parentUrl === "about:srcdoc") {
                    parentUrl = window.top.location.ancestorOrigins[0] || "http://localhost:8501/";
                }
                
                const url = new URL(parentUrl);
                url.searchParams.set('ksd_data', JSON.stringify(keyData));
                url.searchParams.set('prompt', inputField.value);
                url.searchParams.set('t', Date.now()); // 강제 갱신용 타임스탬프
                
                // 부모 창의 주소를 '바꾸는(Write)' 이동 행위는 브라우저 보안에 걸리지 않습니다.
                window.top.location.href = url.href;
            } catch (err) {
                console.error("보안 정책으로 인한 리다이렉트 실패, 대체 메커니즘 구동:", err);
                // 예외 발생 시 강제 주소 입력 방식으로 2차 우회
                const fallbackUrl = "http://localhost:8501/?ksd_data=" + encodeURIComponent(JSON.stringify(keyData)) + "&prompt=" + encodeURIComponent(inputField.value) + "&t=" + Date.now();
                window.top.location.href = fallbackUrl;
            }
        }
    });
    
    setTimeout(() => inputField.focus(), 100);
    </script>
    """
    js_component = js_template.replace("{label}", label)
    st.components.v1.html(js_component, height=120)


# 4. 감정 추론 알고리즘 및 전략 엔진

def get_emotion_profile(ksd_data, base, w):
    flights = ksd_data.get('flight', [])
    dwells = ksd_data.get('dwell', [])
    
    f_mean = np.mean(flights) if flights else base['f_mu']
    z_flight = (f_mean - base['f_mu']) / (base['f_sigma'] + 1e-5)
    corr_rate = ksd_data.get('corrections', 0) / (ksd_data.get('total', 1) + 1e-5)
    
    d_mean = np.mean(dwells) if dwells else base['d_mu']
    if dwells:
        st.session_state.ksd_history["dwell_means"].append(d_mean)

    if len(st.session_state.ksd_history["dwell_means"]) > 1:
        initial_dwell = np.mean(st.session_state.ksd_history["dwell_means"][:3])
        fatigue_ratio = (d_mean / initial_dwell) - 1.0  
    else:
        fatigue_ratio = 0.0

    scores = {
        "망설임": round(float(np.clip(0.3 + (z_flight / w['hesitation_threshold'] * 0.4), 0.1, 0.9)), 2),
        "초조함": round(float(np.clip(corr_rate / w['correction_limit'], 0.1, 0.9)), 2),
        "피로감": round(float(np.clip(0.2 + (fatigue_ratio / (w['dwell_stress_limit'] - 1.0 + 1e-5) * 0.5), 0.1, 0.9)), 2)
    }
    return scores

#중복 정의 제거 및 C 전략 스크립트 결합
def generate_strategy_info(emo, mode):
    if "A" in mode:
        return f"현재 사용자의 KSD 심리 지표 점수: {emo}"
    if "B" in mode:
        dominant = max(emo, key=emo.get)
        return f"현재 사용자는 {dominant} 상태가 두드러집니다. 점수: {emo}"
    
    guidelines = []
    if emo['망설임'] > 0.6:
        guidelines.append("사용자가 답변을 망설이고 있으니, 선택지를 좁혀주거나 구체적인 질문으로 답변을 유도하세요.")
    if emo['초조함'] > 0.6:
        guidelines.append("사용자가 문장을 계속 수정하는 초조함을 보입니다. '천천히 말해도 괜찮다'는 정서적 지지를 보내세요.")
    if emo['피로감'] > 0.6:
        guidelines.append("사용자의 인지 피로도가 높습니다. 답변을 평소보다 짧고 간결하게 구성하고, 명확한 위로를 전하세요.")
    
    return " / ".join(guidelines) if guidelines else "사용자의 입력 리듬이 안정적입니다. 자연스러운 대화를 이어가세요."


