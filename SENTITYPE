    capture_ksd("위 문장을 똑같이 입력하고 엔터를 누르세요")
    
    if "last_ksd_from_js" in st.session_state and st.session_state.last_ksd_from_js:
        data = st.session_state.pop("last_ksd_from_js")
        if len(data.get('dwell', [])) > 5:
            st.session_state.baseline = {
                'f_mu': np.mean(data['flight']), 'f_sigma': np.std(data['flight']),
                'd_mu': np.mean(data['dwell']), 'd_sigma': np.std(data['dwell'])
            }
            st.session_state.pop("pending_prompt", None)
            st.success("개인별 타이핑 Baseline 수집 완료! 상담 세션으로 이동합니다.")
            time.sleep(1)
            st.rerun()

# 메인 상담 화면
else:
    col1, col2 = st.columns([2, 1])

    with col1:
        st.header("적응형 AI 상담")
        for m in st.session_state.chat_history:
            with st.chat_message(m["role"]):
                st.write(m["content"])
                if m["role"] == "assistant" and "emo_snapshot" in m:
                    emo = m["emo_snapshot"]
                    st.caption(f"📊 분석된 상태: 망설임({emo['망설임']}) | 초조함({emo['초조함']}) | 피로도({emo['피로감']})")
                    if "gen_content" in m:
                        with st.expander("🔍 일반 답변과 비교하기"): st.info(m["gen_content"])

        capture_ksd("메시지를 입력하고 엔터를 누르세요")
        
        if "pending_prompt" in st.session_state:
            prompt = st.session_state.pop("pending_prompt")
            st.session_state.chat_history.append({"role": "user", "content": prompt})
            
            raw_ksd = st.session_state.pop('last_ksd_from_js', {'dwell':[], 'flight':[], 'corrections':0, 'total':1})
            current_emo = get_emotion_profile(raw_ksd, st.session_state.baseline, st.session_state.weights)
            st.session_state.last_emo = current_emo

            info = generate_strategy_info(current_emo, mode)

            if client:
                try:
                    res_gen = client.chat.completions.create(
                        model="gpt-4o", messages=[{"role": "system", "content": "당신은 공감 능력이 뛰어난 상담가입니다."}, {"role": "user", "content": prompt}]
                    )
                    answer_gen = res_gen.choices[0].message.content

                    res_ksd = client.chat.completions.create(
                        model="gpt-4o", messages=[{"role": "system", "content": f"당신은 공감 능력이 뛰어난 상담가입니다. {info}"}, {"role": "user", "content": prompt}]
                    )
                    answer_ksd = res_ksd.choices[0].message.content
                    
                    st.session_state.chat_history.append({
                        "role": "assistant", "content": answer_ksd, "gen_content": answer_gen, "emo_snapshot": current_emo
                    })
                except Exception as e:
                    st.error(f"GPT 호출 중 오류 발생: {e}")
            st.rerun()

    with col2:
        st.header("감정 모니터링")
        if "last_emo" in st.session_state:
            emo_data = st.session_state.last_emo
            options = {
                "radar": {"indicator": [{"name": k, "max": 1} for k in emo_data.keys()], "splitNumber": 4},
                "series": [{"type": "radar", "data": [{"value": list(emo_data.values()), "name": "Emotion State"}], "areaStyle": {"color": "rgba(255, 99, 132, 0.2)"}}]
            }
            st_echarts(options, height="400px")

        st.divider()
        st.subheader("모델 최적화 (Feedback)")
        target = st.selectbox("수정이 필요한 감정", ["없음", "망설임", "초조함", "피로감"])
        if target != "없음":
            actual_level = st.slider(f"실제 느낀 '{target}' 정도 (0:낮음 ~ 1:높음)", 0.0, 1.0, 0.5)
            if st.button("가중치 업데이트"):
                lr = st.session_state.weights['learning_rate']
                error = st.session_state.last_emo[target] - actual_level
                
                # [수정] 초조함과 피로감 가중치 피드백 수학적 모델 전 지표 확장
                if target == "망설임":
                    st.session_state.weights['hesitation_threshold'] += error * lr
                elif target == "초조함":
                    st.session_state.weights['correction_limit'] -= error * lr
                elif target == "피로감":
                    st.session_state.weights['dwell_stress_limit'] += error * lr
                st.success(f"가중치 반영 완료. 이제 '{target}' 분석이 더 정교해집니다.")

if st.session_state.baseline:
    if st.button("최종 가중치 결과 확인"): st.json(st.session_state.weights)
